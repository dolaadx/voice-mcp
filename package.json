{
  "name": "voice-mcp",
  "version": "1.1.0-c3",
  "description": "OAuth-protected MCP server for private voice synthesis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-loader ./tests/cloudflare-loader.mjs --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "0.22.0",
    "jose": "6.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.13.5",
    "ip-address": "10.7.0"
  },
  "keywords": [
    "mcp",
    "voice",
    "tts",
    "text-to-speech",
    "ai",
    "chatgpt",
    "oauth"
  ],
  "license": "MIT"
}
