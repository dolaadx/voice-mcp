{
  "name": "voice-mcp",
  "main": "src/index.ts",
  "keep_vars": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_QUOTA",
        "class_name": "VoiceQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceQuota"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
